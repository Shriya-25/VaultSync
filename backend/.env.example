# ==============================================================================
# VaultSync Backend — Environment Configuration Template
# Copy this file to .env or export these variables in your shell.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/vaultsync
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JPA DDL Configuration (use 'update' for development, 'validate' for production)
JPA_DDL_AUTO=update

# Frontend CORS Origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
